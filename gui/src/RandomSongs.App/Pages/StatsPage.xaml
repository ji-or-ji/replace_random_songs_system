<Page
    x:Class="RandomSongs.App.Pages.StatsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="16">
        <StackPanel Spacing="16" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="统计信息" FontSize="18" FontWeight="SemiBold" />

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="总统计" FontWeight="SemiBold" />
                    <TextBlock x:Name="TotalsText" TextWrapping="Wrap" />
                    <TextBlock Text="点歌人分布" Opacity="0.7" />
                    <ListView x:Name="RequesterList" MaxHeight="200" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="搜索歌曲" FontWeight="SemiBold" />
                    <TextBox x:Name="SearchBox" PlaceholderText="按 歌名 / 歌手 / 点歌人 / UUID 搜索"
                             TextChanged="SearchBox_TextChanged" />
                    <TextBlock x:Name="SearchInfo" Opacity="0.7" />
                    <ListView x:Name="SearchResults" MaxHeight="280" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Padding="4,6">
                                    <TextBlock Text="{Binding SongName}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding SubText}" FontSize="12" Opacity="0.7"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="历史记录" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox x:Name="HistoryScopeBox" Width="260" SelectionChanged="HistoryScope_Changed">
                            <ComboBoxItem Content="本歌单 · 播放历史" Tag="PlaylistPlay" />
                            <ComboBoxItem Content="本歌单 · 操作历史" Tag="PlaylistOperate" />
                            <ComboBoxItem Content="全局 · 播放历史" Tag="GlobalPlay" />
                            <ComboBoxItem Content="全局 · 操作历史" Tag="GlobalOperate" />
                        </ComboBox>
                        <Button Content="刷新" Click="HistoryRefresh_Click" />
                    </StackPanel>
                    <TextBlock x:Name="HistoryInfo" Opacity="0.7" />
                    <ListView x:Name="HistoryList" MaxHeight="320" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
