<Page
    x:Class="RandomSongs.App.Pages.PlaylistsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="ParsedRowTemplate">
            <StackPanel Padding="4,6">
                <TextBlock Text="{Binding SongName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Artist}" FontSize="12" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding NoteText}" FontSize="11" Opacity="0.5" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText" Grid.Row="0" FontSize="18" FontWeight="SemiBold" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button Content="切换为当前" Click="Switch_Click" Style="{StaticResource AccentButtonStyle}" />
            <Button Content="新建歌单" Click="New_Click" />
            <Button Content="重命名" Click="Rename_Click" />
            <Button Content="删除" Click="Delete_Click" />
            <Button Content="刷新" Click="Refresh_Click" />
        </StackPanel>

        <ListView x:Name="PlaylistList" Grid.Row="2" SelectionMode="Single"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1" CornerRadius="8">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Padding="6,8">
                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding SubText}" FontSize="12" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="3" Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="从文件导入" Click="ImportFile_Click" />
                <Button Content="从文件夹导入" Click="ImportFolder_Click" />
                <Button Content="从 QQ 歌单导入" Click="ImportQq_Click" />
                <Button Content="备份本歌单" Click="BackupOne_Click" />
                <Button Content="备份全部" Click="BackupAll_Click" />
                <Button Content="从备份恢复" Click="Restore_Click" />
            </StackPanel>
            <TextBlock x:Name="BackupInfo" FontSize="12" Opacity="0.7" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
        </StackPanel>
    </Grid>
</Page>
