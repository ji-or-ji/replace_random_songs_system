<Window
    x:Class="RandomSongs.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <InfoBar x:Name="StatusBar" Grid.Row="0" IsOpen="False" IsClosable="True" Margin="12,12,12,0" />

        <NavigationView x:Name="Nav" Grid.Row="1"
                        IsSettingsVisible="False" IsBackButtonVisible="Collapsed"
                        PaneDisplayMode="Left" OpenPaneLength="190"
                        SelectionChanged="Nav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavPick" Content="随机点歌" Tag="pick" />
                <NavigationViewItem Content="统计信息" Tag="stats" />
                <NavigationViewItem Content="歌单管理" Tag="playlists" />
                <NavigationViewItem Content="歌曲管理" Tag="songs" />
                <NavigationViewItem Content="点歌人" Tag="requesters" />
                <NavigationViewItem Content="设置" Tag="settings" />
            </NavigationView.MenuItems>
            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
